<?xml version="1.0" encoding="UTF-8"?>
<!-- Builds target/signing-keys-tool-<version>.jar, and copies it to signing-keys-tool.jar in this folder: mvn package -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.primelogiclab.tools</groupId>
    <artifactId>signing-keys-tool</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>
    <name>Signing Keys Tool</name>
    <description>Creates and checks RSA key pairs (PEM files) for digital signatures with SHA256withRSA (RS256 in JWTs), one pair per environment or client.</description>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <!-- Java 8 bytecode, so the jar also runs on servers that are still on Java 8 -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- tests only: the tool itself has no dependencies -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <!-- the jar is target/signing-keys-tool-<version>.jar, Maven's standard name and place -->
                    <archive>
                        <manifest>
                            <mainClass>io.primelogiclab.tools.signingkeystool.SigningKeysTool</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-jar-for-launchers</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- the launchers (signing-keys-tool.cmd and .sh) look for signing-keys-tool.jar next to
                                     themselves, without a version; the copy is in .gitignore -->
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      tofile="${project.basedir}/${project.artifactId}.jar" overwrite="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
